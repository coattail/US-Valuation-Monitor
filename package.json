{
  "name": "us-valuation-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "cloudfunctions"
  ],
  "scripts": {
    "build:data:index": "node packages/data-pipeline/src/build-snapshot.ts && node scripts/repair-data-gaps.mjs index && node packages/data-pipeline/src/split-index-dataset.ts",
    "build:data:company": "node packages/data-pipeline/src/build-company-snapshot.ts && node scripts/repair-data-gaps.mjs company && node packages/data-pipeline/src/split-company-dataset.ts",
    "validate:data:company": "node scripts/validate-company-series.mjs",
    "build:data": "npm run build:data:index && npm run build:data:company",
    "build:site": "node scripts/build-static-site.mjs",
    "import:fmp-forward-pe": "node scripts/import-fmp-forward-pe.mjs",
    "refresh:data:local": "bash scripts/refresh-local-data.sh",
    "repair:data:nasdaq100-ttm": "node scripts/repair-nasdaq100-ttm-history.mjs",
    "repair:data:nasdaq100-forward": "node scripts/repair-nasdaq100-forward-history.mjs",
    "install:local-refresh": "bash scripts/install-local-refresh-launchd.sh",
    "start:api": "node cloudfunctions/server.ts",
    "start:web": "python3 -m http.server 9030",
    "test": "node --test packages/core/tests/*.test.ts packages/data-pipeline/tests/*.test.ts cloudfunctions/tests/*.test.ts apps/web/*.test.mjs scripts/*.test.mjs",
    "dev": "node cloudfunctions/server.ts",
    "validate:data:freshness": "node scripts/validate-data-freshness.mjs index && node scripts/validate-data-freshness.mjs company"
  }
}
